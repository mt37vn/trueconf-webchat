# TrueConf Server FQDN (e.g., trueconf.company.com)
TRUECONF_SERVER=your-server.com

# OAuth2 Credentials from TrueConf API Panel
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret

# Bot account details
BOT_USER=bot_username
BOT_PASS=bot_password

# The port where this Node.js server will run
PORT=3000

# Comma-separated list of TrueConf IDs for support staff
STAFF_USER=staff1@yourdomain.com, staff2@yourdomain.com
